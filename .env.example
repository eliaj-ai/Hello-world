# =====================================================================
# SaaS AI Solutions - example environment file
#
# HOW TO USE THIS FILE:
#   1. Copy it:      cp .env.example .env
#   2. Fill in real values in .env
#   3. NEVER commit .env - it is already listed in .gitignore
#
# This file (.env.example) contains NO real secrets. It exists so that
# other developers know which settings the application expects.
# =====================================================================

# ---- Which configuration to load: development | testing | production ----
FLASK_ENV=development

# ---- Secret key --------------------------------------------------------
# Used to sign session cookies and CSRF tokens. Must be long and random.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-value

# ---- Database ----------------------------------------------------------
# Local development uses SQLite and needs no configuration.
# For production, set a PostgreSQL URL, for example:
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=

# ---- Email (not active yet) -------------------------------------------
# The contact form currently SAVES messages to the database only.
# Sending email stays switched off until MAIL_ENABLED=true and the
# settings below are filled in.
MAIL_ENABLED=false
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
CONTACT_RECIPIENT=

# ---- Public site URL (used for sitemap.xml and Open Graph tags) -------
SITE_URL=http://127.0.0.1:5000
