# --- Secrets: never commit these ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python virtual environments ---
venv/
.venv/
env/
ENV/

# --- Python build / cache artefacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Databases (local development data) ---
*.db
*.sqlite
*.sqlite3
instance/

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Editors and OS files ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/
